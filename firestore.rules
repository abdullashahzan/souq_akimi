rules_version = '2';

// Souq Akimi — Firestore security rules.
//
// This project runs on Firebase's Spark (free) plan, which cannot deploy Cloud
// Functions, so every delivery transition runs as a *client* transaction and
// THESE RULES ARE THE TRUST LAYER: they decide which transactions may commit.
// The Dart side lives in `lib/data/repositories/order_repository.dart`.
//
// The invariants that matter:
//   1. An order, its deliveries, their hand-over secrets, the seller's
//      notification and the stock decrement are written in ONE transaction.
//      Rules read the siblings with getAfter(), so a half-written order cannot
//      exist and stock can never drift from the orders that consumed it.
//   2. Only the seller who owns a delivery may mark it `delivered`, and only
//      by presenting the buyer's 6-digit code, which is compared against a
//      document (`deliverySecrets`) the seller is forbidden to read. A wrong
//      guess commits nothing.
//   3. Only the buyer may cancel or mint a new code; five failed attempts lock
//      a seller out until the buyer rotates the code.
//   4. Every order is cash on delivery, so there is no money to hold, capture
//      or refund — the app never touches a card or a payment provider.
//
// Stock movements carry lastOrderId and must prove a new order or a one-time
// cancellation. Private contacts never share a document with public profiles.
// See docs/firestore_schema.md for the full threat model.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && (isAdmin() || accountActive(request.auth.uid));
    }

    function accountActive(uid) {
      return !exists(/databases/$(database)/documents/userAccess/$(uid))
        || get(/databases/$(database)/documents/userAccess/$(uid)).data.status == 'active';
    }

    function canCreate() {
      return isSignedIn() && (isAdmin()
        || !exists(/databases/$(database)/documents/appConfig/control)
        || get(/databases/$(database)/documents/appConfig/control).data.get('maintenance', false) == false);
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The single marketplace administrator. The email is verified at account
    // creation; the UI hides the dashboard for everyone else, but this is the
    // boundary that actually protects the data.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'abdullashahzan@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    match /userAccess/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && uid != request.auth.uid && uid != 'srXNKWjiXBbza3JTfg4CAaHN4vx1'
        && request.resource.data.keys().hasOnly(['status', 'reason', 'actorId', 'updatedAt'])
        && request.resource.data.status in ['active', 'suspended', 'deleted']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/userAccess/$(uid))
          || resource.data.status != 'deleted' || request.resource.data.status == 'deleted');
      allow delete: if false;
    }

    match /appConfig/{id} {
      allow read: if id in ['control', 'launchMessage'];
      allow write: if isAdmin() && (
        (id == 'control' && request.resource.data.maintenance is bool
          && request.resource.data.message is string && request.resource.data.message.size() <= 2000)
        || (id == 'launchMessage' && request.resource.data.active is bool
          && (request.resource.data.active == false
            || (request.resource.data.id is string && request.resource.data.id.size() > 0
              && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
              && request.resource.data.body is string && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 4000
              && request.resource.data.everyLaunch is bool)))
      );
    }

    match /announcements/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /adminAudit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // DELIVERY_OTP_MAX_ATTEMPTS (keep in sync with AppConfig.otpMaxAttempts).
    function otpMaxAttempts() {
      return 5;
    }

    function completedSale(uid) {
      let orderId = request.resource.data.salesOrderId;
      let deliveryId = request.resource.data.salesDeliveryId;
      let before = get(/databases/$(database)/documents/orders/$(orderId)/deliveries/$(deliveryId));
      let after = getAfter(/databases/$(database)/documents/orders/$(orderId)/deliveries/$(deliveryId));
      return before.data.status == 'ready' && after.data.status == 'delivered'
        && after.data.sellerId == uid && after.data.deliveredAt == request.time;
    }

    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || (isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'salesCount'])
        && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.salesCount == getAfter(/databases/$(database)/documents/users/$(uid)).data.get('salesCount', 0));
      allow delete: if isAdmin() && uid != request.auth.uid && uid != 'srXNKWjiXBbza3JTfg4CAaHN4vx1';
    }

    // ----- users ----------------------------------------------------------
    match /users/{uid} {
      // Signed-in students can resolve seller names and sales tallies. Guests
      // see the catalogue without profiles, which keeps phone/room private.
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('salesCount', 0) == 0;
      // A profile edit may not touch the tally; completing a delivery may bump
      // it by exactly one on the seller's own document. The tally is a public
      // vanity metric, so the worst a determined seller can do is inflate it.
      allow update: if isSelf(uid) && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['salesCount', 'updatedAt', 'salesOrderId', 'salesDeliveryId'])
          && request.resource.data.salesCount == resource.data.get('salesCount', 0) + 1
          && completedSale(uid)
        )
        ||
        (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['salesCount'])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'username', 'email', 'displayName', 'photoUrl', 'phone',
               'building', 'roomNumber', 'updatedAt', 'onboardingCompleted'
             ])
          && request.resource.data.get('onboardingCompleted', false) is bool
        )
      ) || isAdmin();
      allow delete: if isAdmin() && uid != request.auth.uid && uid != 'srXNKWjiXBbza3JTfg4CAaHN4vx1';

      // Each user's in-app inbox. A buyer writes one `new_sale` item for the
      // seller inside the same transaction that creates the order; the rules
      // verify that link with getAfter(). Nobody else can create anything in
      // someone's inbox, and only the owner can read or clear it.
      match /notifications/{notificationId} {
        function saleOrder(orderNumber) {
          return getAfter(/databases/$(database)/documents/orders/$(orderNumber));
        }

        function requestAfter(requestId) {
          return getAfter(
            /databases/$(database)/documents/serviceRequests/$(requestId)
          );
        }

        function requestBefore(requestId) {
          return get(/databases/$(database)/documents/serviceRequests/$(requestId));
        }

        allow read, delete: if isSelf(uid) || isAdmin();

        allow create: if isSignedIn()
          && request.resource.data.userId == uid
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time
          && (
            // A buyer placing an order, in the same transaction.
            (
              request.resource.data.actorId == request.auth.uid
              && request.resource.data.type == 'new_sale'
              && request.resource.data.orderNumber is string
              && request.resource.data.orderNumber != ''
              && saleOrder(request.resource.data.orderNumber).data.userId
                   == request.auth.uid
              && uid in saleOrder(request.resource.data.orderNumber).data.sellerIds
              && saleOrder(request.resource.data.orderNumber).data.createdAt
                   == request.time
            )
            ||
            // A student asking for a service, born with the request itself.
            (
              request.resource.data.actorId == request.auth.uid
              && request.resource.data.type == 'service_request'
              && request.resource.data.requestId is string
              && request.resource.data.requestId != ''
              && requestAfter(request.resource.data.requestId).data.providerId
                   == uid
              && requestAfter(request.resource.data.requestId).data.requesterId
                   == request.auth.uid
              && requestAfter(request.resource.data.requestId).data.createdAt
                   == request.time
            )
            ||
            // Request responses/cancellations are coupled to a single pending
            // transition; replaying an old request cannot spam a recipient.
            (
              request.resource.data.actorId == request.auth.uid
              && request.resource.data.requestId is string
              && notificationId == request.resource.data.requestId + '_'
                   + requestAfter(request.resource.data.requestId).data.status
              && (requestBefore(request.resource.data.requestId).data.status == 'pending'
                  || (requestBefore(request.resource.data.requestId).data.status == 'accepted'
                      && requestAfter(request.resource.data.requestId).data.status == 'completed'))
              && requestAfter(request.resource.data.requestId).data.respondedAt == request.time
              && (
                (request.resource.data.type in ['request_accepted', 'request_declined', 'request_completed']
                  && request.auth.uid == requestBefore(request.resource.data.requestId).data.providerId
                  && uid == requestBefore(request.resource.data.requestId).data.requesterId
                  && request.resource.data.type == 'request_' + requestAfter(request.resource.data.requestId).data.status
                  && requestAfter(request.resource.data.requestId).data.status in ['accepted', 'declined', 'completed'])
                ||
                (request.resource.data.type == 'request_cancelled'
                  && request.auth.uid == requestBefore(request.resource.data.requestId).data.requesterId
                  && uid == requestBefore(request.resource.data.requestId).data.providerId
                  && requestAfter(request.resource.data.requestId).data.status == 'cancelled')
              )
            )
            ||
            // The administrator broadcasting to every inbox.
            (
              isAdmin()
              && request.resource.data.actorId == request.auth.uid
              && request.resource.data.type == 'announcement'
            )
          );

        // Reading the inbox is the only thing that changes: mark read.
        allow update: if (isSelf(uid) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // ----- products -------------------------------------------------------
    match /products/{productId} {
      function legitimateStockMove() {
        let id = request.resource.data.lastOrderId;
        let after = getAfter(/databases/$(database)/documents/orders/$(id));
        let item = after.data.items[0];
        return after.data.userId == request.auth.uid
          && item.productId == productId && item.quantity is int && item.quantity > 0 && item.quantity <= 999
          && request.resource.data.stock is int && request.resource.data.stock >= 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','soldCount','updatedAt','lastOrderId'])
          && request.resource.data.updatedAt == request.time
          && ((
            !exists(/databases/$(database)/documents/orders/$(id))
            && after.data.createdAt == request.time && after.data.status == 'pending'
            && request.resource.data.stock == resource.data.stock - item.quantity
            && request.resource.data.soldCount == resource.data.soldCount + item.quantity
          ) || (
            get(/databases/$(database)/documents/orders/$(id)).data.status == 'pending'
            && after.data.status == 'cancelled'
            && request.resource.data.stock == resource.data.stock + item.quantity
            && request.resource.data.soldCount == resource.data.soldCount
          ));
      }
      allow read: if true;
      allow create: if canCreate()
        && request.resource.data.sellerId == request.auth.uid;
      // Owner may edit, but sellerId must stay the same.
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId);
      // Stock movement that is NOT an owner edit: a buyer decrementing stock
      // while placing an order, or restoring it on a cancellation. Only these
      // three fields may move, `soldCount` must travel with `stock` and the
      // delta is bounded to 999 — so a stranger can never reprice, deactivate
      // or delete someone else's listing, only nudge its counters.
      allow update: if isSignedIn()
        && resource.data.sellerId != request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && legitimateStockMove();
      // Anyone signed in may record a single view — and touch nothing else.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewsCount'])
        && request.resource.data.viewsCount == resource.data.viewsCount + 1;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    // ----- services -------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;
      allow create: if canCreate()
        && request.resource.data.providerId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.providerId == request.auth.uid
          && request.resource.data.providerId == resource.data.providerId);
      // Anyone signed in may record a single view — and touch nothing else.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['viewsCount'])
        && request.resource.data.viewsCount == resource.data.viewsCount + 1;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.providerId == request.auth.uid);
    }

    // ----- serviceRequests ------------------------------------------------
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.providerId == request.auth.uid
            || isAdmin());

      allow create: if canCreate()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.providerId is string
        && request.resource.data.providerId != ''
        && request.resource.data.providerId != request.auth.uid
        && accountActive(request.resource.data.providerId)
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.isActive == true
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.providerId == request.resource.data.providerId
        && request.resource.data.phone is string
        && request.resource.data.phone != ''
        && request.resource.data.building is string
        && request.resource.data.building != ''
        && request.resource.data.roomNumber is string
        && request.resource.data.roomNumber != ''
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
        && request.resource.data.respondedAt == request.time && (
        // Provider may only accept or decline.
        (resource.data.providerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt'])
           && ((resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined'])
               || (resource.data.status == 'accepted' && request.resource.data.status == 'completed')))
        ||
        // Requester may only cancel.
        (resource.data.requesterId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt'])
          && request.resource.data.status == 'cancelled')
      );

      allow delete: if false;
    }

    // ----- orders ---------------------------------------------------------
    match /orders/{orderNumber} {

      // The parent order, as it was BEFORE this request (get) and as it will
      // be AFTER it (getAfter) — the latter is what lets the rules verify the
      // order, its deliveries, its secrets and the stock move as one unit.
      function order() {
        return get(/databases/$(database)/documents/orders/$(orderNumber));
      }
      function orderAfter() {
        return getAfter(/databases/$(database)/documents/orders/$(orderNumber));
      }
      // The first line must be paid for in the same transaction that creates
      // the order: stock down by `quantity`, soldCount up by `quantity`.
      function firstLineStockPaidFor(item) {
        return accountActive(item.sellerId)
          && item.sellerId != request.auth.uid
          && item.quantity is int && item.quantity >= 1 && item.quantity <= 999
          && item.price == get(/databases/$(database)/documents/products/$(item.productId)).data.price
          && item.lineTotal == math.round(item.price * item.quantity * 100) / 100
          && getAfter(/databases/$(database)/documents/products/$(item.productId)).data.lastOrderId == orderNumber
          && get(/databases/$(database)/documents/products/$(item.productId)).data.sellerId == item.sellerId
          && get(/databases/$(database)/documents/products/$(item.productId)).data.isActive == true
          && get(/databases/$(database)/documents/products/$(item.productId)).data.get('isDemo', false) == false
          && getAfter(/databases/$(database)/documents/products/$(item.productId)).data.stock
               == get(/databases/$(database)/documents/products/$(item.productId)).data.stock
                    - item.quantity
          && getAfter(/databases/$(database)/documents/products/$(item.productId)).data.soldCount
               == get(/databases/$(database)/documents/products/$(item.productId)).data.soldCount
                     + item.quantity;
      }

      function completeOrderCreated(item) {
        let delivery = getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliveries/$(item.sellerId));
        let secret = getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliverySecrets/$(item.sellerId));
        let notification = getAfter(/databases/$(database)/documents/users/$(item.sellerId)/notifications/$(('n-' + orderNumber)));
        return delivery.data.status == 'ready' && delivery.data.amount == item.lineTotal
          && secret.data.code.matches('^[0-9]{6}$') && notification.data.type == 'new_sale'
          && notification.data.orderNumber == orderNumber && notification.data.createdAt == request.time;
      }

      // Visible to the buyer and to any seller with a delivery in the order.
      //
      // The `!exists()` arm matters: placing an order starts a transaction
      // that probes the freshly generated order id to make sure it is free.
      // Reading an *absent* document is evaluated against `resource == null`,
      // so a plain participant rule would answer with permission-denied and
      // abort the whole checkout. Allowing the probe (and nothing else) keeps
      // the collision check — and still hides everyone else's orders.
      allow get: if isAdmin()
        || (isSignedIn()
          && (!exists(/databases/$(database)/documents/orders/$(orderNumber))
              || resource.data.userId == request.auth.uid
              || request.auth.uid in resource.data.sellerIds));

      // Queries cannot prove a missing document, so listing stays scoped.
      allow list: if isAdmin()
        || (isSignedIn()
          && (resource.data.userId == request.auth.uid
              || request.auth.uid in resource.data.sellerIds));

      // Cash on delivery, one line, delivered to the buyer's hostel room.
      allow create: if canCreate()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderNumber == orderNumber
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.fullName is string
        && request.resource.data.fullName != ''
        && request.resource.data.phone is string
        && request.resource.data.phone != ''
        && request.resource.data.building is string
        && request.resource.data.building != ''
        && request.resource.data.roomNumber is string
        && request.resource.data.roomNumber != ''
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 1000000
        && request.resource.data.items is list
        && request.resource.data.items.size() == 1
        && request.resource.data.sellerIds is list
        && request.resource.data.sellerIds.size() == 1
        // Souq is cartless: one line, one seller, total == line total, and
        // that line's stock must have moved in this very transaction. The
        // New orders are strictly single-line; extra lines may not bypass the
        // seller-access, active-listing, demo and stock checks below.
        && (request.resource.data.total
                   == request.resource.data.items[0].lineTotal
                && request.resource.data.sellerIds
                  == [request.resource.data.items[0].sellerId]
                  && firstLineStockPaidFor(request.resource.data.items[0])
                  && completeOrderCreated(request.resource.data.items[0]));

      // Participants may recompute the summary status (a denormalised view —
      // the per-delivery rules are what actually complete an order). Nothing
      // else on an order is ever editable.
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || request.auth.uid in resource.data.sellerIds)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status'])
         && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliveries/$(resource.data.sellerIds[0])).data.status
         && request.resource.data.status in ['delivered', 'cancelled'];

      allow delete: if false;

      // ----- deliveries ---------------------------------------------------
      match /deliveries/{deliveryId} {

        function secret() {
          return get(/databases/$(database)/documents/orders/$(orderNumber)
                     /deliverySecrets/$(deliveryId));
        }

        allow read: if isSignedIn()
          && (order().data.userId == request.auth.uid
              || request.auth.uid in order().data.sellerIds);

        // The buyer writes one delivery per seller, in the same transaction
        // that creates the order itself (an order may never grow new legs).
        allow create: if isSignedIn()
          && orderAfter().data.userId == request.auth.uid
          && orderAfter().data.createdAt == request.time
          && request.resource.data.id == deliveryId
          && request.resource.data.sellerId is string
          && request.resource.data.sellerId != ''
          && request.resource.data.sellerId in orderAfter().data.sellerIds
          && deliveryId == request.resource.data.sellerId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.otpAttempts == 0
          && request.resource.data.status == 'ready'
          && request.resource.data.createdAt == request.time;

        // 1. The seller completes their delivery — only by presenting the
        //    buyer's code, read from a document this seller can never open.
        //    Amount and the attempt counter are frozen, and the order must not
        //    have been cancelled underneath.
        allow update: if isSignedIn()
          && resource.data.sellerId == request.auth.uid
          && resource.data.status == 'ready'
          && resource.data.otpAttempts > 0 && resource.data.otpAttempts <= otpMaxAttempts()
          && request.resource.data.status == 'delivered'
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.otpAttempts == resource.data.otpAttempts
          && request.resource.data.deliveredAt == request.time
          && request.resource.data.otpEntered == resource.data.pendingCode
          && resource.data.pendingCode == secret().data.code
          && order().data.status != 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'otpEntered', 'deliveredAt']);

        // 2. Store and count a guess BEFORE comparison. A rejected completion
        //    can only retry the same stored code, not test another candidate.
        //    Five committed guesses lock out new guesses until buyer rotation.
        allow update: if isSignedIn()
          && resource.data.sellerId == request.auth.uid
          && resource.data.status == 'ready'
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['otpAttempts', 'pendingCode'])
          && request.resource.data.pendingCode is string
          && request.resource.data.pendingCode.matches('^[0-9]{6}$')
          && request.resource.data.otpAttempts
               == resource.data.otpAttempts + 1
          && request.resource.data.otpAttempts <= otpMaxAttempts();

        // 3. The buyer cancels one seller's leg — never once it was delivered.
        allow update: if isSignedIn()
          && order().data.userId == request.auth.uid
          && resource.data.status == 'ready'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
          && orderAfter().data.status == 'cancelled';

        // 4. The buyer resets the attempt counter (a rotation writes the new
        //    code on the sibling secret in the same transaction).
        allow update: if isSignedIn()
          && order().data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['otpAttempts', 'pendingCode'])
          && request.resource.data.otpAttempts == 0 && request.resource.data.pendingCode == ''
          && resource.data.status == 'ready'
          && getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliverySecrets/$(deliveryId)).data.code != secret().data.code;

        allow delete: if false;
      }

      // ----- deliverySecrets ---------------------------------------------
      // The hand-over code. Written with the order by the buyer, read only by
      // the buyer (the seller types it from what they were told in person),
      // compared server-side by the delivery rule above.
      match /deliverySecrets/{deliveryId} {
        allow read: if isSignedIn()
          && orderAfter().data.userId == request.auth.uid;

        allow create: if isSignedIn()
          && orderAfter().data.userId == request.auth.uid
          && request.resource.data.deliveryId == deliveryId
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[0-9]{6}$');

        // Rotation: a fresh code, nothing else touched.
        allow update: if isSignedIn()
          && order().data.userId == request.auth.uid
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[0-9]{6}$')
          && getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliveries/$(deliveryId)).data.otpAttempts == 0
          && getAfter(/databases/$(database)/documents/orders/$(orderNumber)/deliveries/$(deliveryId)).data.pendingCode == ''
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['code']);

        allow delete: if false;
      }
    }

    // ----- images (listing photos stored in Firestore) --------------------
    match /images/{imageId} {
      // The catalogue is public, so its photos are too.
      allow read: if true;
      // Only the owner may add one, and only within the size budget the
      // client promises (base64 of a photo the client has already resized).
      allow create: if canCreate()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.size <= 640 * 1024;
      // A photo is immutable: replace it by creating another and updating
      // the listing, then deleting this one.
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ----- everything else: denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
